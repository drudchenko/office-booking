<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Testcontainers is chatty about image pulls and Ryuk; keep only what helps when a run fails. -->
    <logger name="org.testcontainers" level="INFO"/>
    <logger name="tc" level="INFO"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <!-- Application output is only interesting when startup goes wrong, and then it fails loudly anyway. -->
    <logger name="office-booking-app" level="WARN"/>
</configuration>
